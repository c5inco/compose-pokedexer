#!/usr/bin/env bash
set -euo pipefail

readonly ANDROID_SDK="$HOME/.android-sdk"
readonly JAVA_17_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
readonly LOCAL_BIN="$HOME/.local/bin"
readonly TOOLCHAIN_PROFILE_MARKER="# compose-pokedexer Android CLI toolchain"
readonly AMP_AGENT_CONFIG_DIR="$HOME/.config/amp"
readonly ORB_GUIDANCE_MARKER="# compose-pokedexer Amp Orb isolation override"

mkdir -p "$AMP_AGENT_CONFIG_DIR"
if ! grep -Fqx "$ORB_GUIDANCE_MARKER" "$AMP_AGENT_CONFIG_DIR/AGENTS.md" 2>/dev/null; then
    cat >> "$AMP_AGENT_CONFIG_DIR/AGENTS.md" <<'EOF'

# compose-pokedexer Amp Orb isolation override

- When working in the compose-pokedexer checkout, treat the Orb as sufficient filesystem isolation.
- This overrides the repository Worktree Policy: do not prompt for or create an additional Git worktree.
- If Git isolation is needed, creating a task-specific feature branch is pre-approved and requires no prompt.
- All other repository Git and GitHub safeguards continue to apply.
EOF
fi

echo "Installing the Java 17 toolchain..."
if [[ ! -x "$JAVA_17_HOME/bin/java" ]]; then
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y openjdk-17-jdk-headless
fi

export JAVA_HOME="$JAVA_17_HOME"
export ANDROID_HOME="$ANDROID_SDK"
export ANDROID_SDK_ROOT="$ANDROID_SDK"
export PATH="$JAVA_HOME/bin:$LOCAL_BIN:$ANDROID_SDK/platform-tools:$PATH"

if ! grep -Fqx "$TOOLCHAIN_PROFILE_MARKER" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<EOF

$TOOLCHAIN_PROFILE_MARKER
export JAVA_HOME="$JAVA_17_HOME"
export ANDROID_HOME="$ANDROID_SDK"
export ANDROID_SDK_ROOT="$ANDROID_SDK"
export PATH="\$JAVA_HOME/bin:$LOCAL_BIN:\$ANDROID_HOME/platform-tools:\$PATH"
EOF
fi

echo "Installing Android CLI..."
if [[ ! -x "$LOCAL_BIN/android" ]]; then
    installer="$(mktemp)"
    trap 'rm -f "$installer"' EXIT
    curl -fsSL https://dl.google.com/android/cli/latest/linux_x86_64/install.sh -o "$installer"
    bash "$installer"
    rm -f "$installer"
    trap - EXIT
fi
android update

echo "Installing Android SDK packages..."
android --sdk="$ANDROID_SDK" sdk install \
    platform-tools \
    platforms/android-36 \
    build-tools/36.0.0

echo "Building the Android debug app and warming Gradle dependencies..."
GRADLE_OPTS="-Dorg.gradle.jvmargs=-Xmx1536m -Dfile.encoding=UTF-8" \
    ./gradlew --no-daemon --max-workers=1 \
    -Pkotlin.compiler.execution.strategy=in-process \
    :app:assembleDebug

echo "Orb setup complete."
