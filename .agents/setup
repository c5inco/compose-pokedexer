#!/usr/bin/env bash
set -euo pipefail

readonly ANDROID_SDK="$HOME/.android-sdk"
readonly JAVA_17_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
readonly LOCAL_BIN="$HOME/.local/bin"
readonly MAESTRO_BIN="$HOME/.maestro/bin"
readonly EW_CLI_VERSION="1.4.1"
readonly MAESTRO_VERSION="2.8.0"
readonly TOOLCHAIN_PROFILE_MARKER="# compose-pokedexer Android regression toolchain v2"

echo "Installing the Java 17 toolchain..."
if [[ ! -x "$JAVA_17_HOME/bin/java" ]]; then
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y openjdk-17-jdk-headless
fi

export JAVA_HOME="$JAVA_17_HOME"
export ANDROID_HOME="$ANDROID_SDK"
export ANDROID_SDK_ROOT="$ANDROID_SDK"
export PATH="$JAVA_HOME/bin:$LOCAL_BIN:$MAESTRO_BIN:$ANDROID_SDK/platform-tools:$PATH"
export EW_VERSION="$EW_CLI_VERSION"
export MAESTRO_CLI_NO_ANALYTICS=1
export MAESTRO_CLI_ANALYSIS_NOTIFICATION_DISABLED=true

if ! grep -Fqx "$TOOLCHAIN_PROFILE_MARKER" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<EOF

$TOOLCHAIN_PROFILE_MARKER
export JAVA_HOME="$JAVA_17_HOME"
export ANDROID_HOME="$ANDROID_SDK"
export ANDROID_SDK_ROOT="$ANDROID_SDK"
export PATH="\$JAVA_HOME/bin:$LOCAL_BIN:$MAESTRO_BIN:\$ANDROID_HOME/platform-tools:\$PATH"
export EW_VERSION="$EW_CLI_VERSION"
export MAESTRO_CLI_NO_ANALYTICS=1
export MAESTRO_CLI_ANALYSIS_NOTIFICATION_DISABLED=true
EOF
fi

echo "Installing Android CLI..."
if [[ ! -x "$LOCAL_BIN/android" ]]; then
    installer="$(mktemp)"
    trap 'rm -f "$installer"' EXIT
    curl -fsSL https://dl.google.com/android/cli/latest/linux_x86_64/install.sh -o "$installer"
    bash "$installer"
    rm -f "$installer"
    trap - EXIT
fi
android update

echo "Installing Android SDK packages..."
android --sdk="$ANDROID_SDK" sdk install \
    platform-tools \
    platforms/android-36 \
    build-tools/36.0.0

echo "Installing Android regression test tools..."
if [[ ! -x "$LOCAL_BIN/ew-cli" ]]; then
    curl --fail --show-error --location \
        https://maven.emulator.wtf/releases/ew-cli \
        --output "$LOCAL_BIN/ew-cli"
    chmod u+x "$LOCAL_BIN/ew-cli"
fi
EW_VERSION="$EW_CLI_VERSION" ew-cli --version

installed_maestro_version=""
if [[ -x "$MAESTRO_BIN/maestro" ]]; then
    installed_maestro_version="$("$MAESTRO_BIN/maestro" --version 2>/dev/null | tail -n 1)"
fi
if [[ "$installed_maestro_version" != "$MAESTRO_VERSION" ]]; then
    (
        unset EW_API_TOKEN
        export MAESTRO_VERSION
        curl -fsSL https://get.maestro.mobile.dev | bash
    )
fi
[[ "$(maestro --version 2>/dev/null | tail -n 1)" == "$MAESTRO_VERSION" ]]

echo "Building the Android debug app and warming Gradle dependencies..."
GRADLE_OPTS="-Dorg.gradle.jvmargs=-Xmx1536m -Dfile.encoding=UTF-8" \
    ./gradlew --no-daemon --max-workers=1 \
    -Pkotlin.compiler.execution.strategy=in-process \
    :app:assembleDebug

echo "Orb setup complete."
